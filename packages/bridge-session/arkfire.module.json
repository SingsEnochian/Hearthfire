{
  "schemaVersion": "arkfire.module/v1",
  "moduleId": "arkfire.bridge-session",
  "canonicalName": "Hearthweave Bridge Session",
  "version": "0.1.0",
  "status": "IMPLEMENTED_VERTICAL_SLICE",
  "owner": "Rowan",
  "maintainers": ["Vee"],
  "description": "Standalone consent-aware runtime for one complete Hearthside to Targetside crossing, exchange, return, and replayable receipt.",
  "standalone": true,
  "standaloneEntrypoints": {
    "cli": "node cli.mjs",
    "service": "node cli.mjs serve",
    "demo": "node cli.mjs demo --world terra-aeterna"
  },
  "standaloneInterface": ["CLI", "HTTP health/status"],
  "standaloneDataDirectory": "./data",
  "standaloneHealthCheck": "node cli.mjs health",
  "standaloneTestCommand": "node --test test/*.test.mjs",
  "hostAdapters": [],
  "capabilities": [
    "bridge-session-lifecycle",
    "dual-presence-state",
    "typed-packet-exchange",
    "consent-pause",
    "explicit-return-anchor",
    "plain-presentation-pass",
    "jsonl-ledger-replay",
    "epistemic-register-enforcement"
  ],
  "dataContracts": [
    "schema/bridge-session.schema.json",
    "schema/bridge-packet.schema.json"
  ],
  "dataOwnership": ["bridge session ledger", "bridge session state"],
  "storageLocations": ["./data/bridge-session-ledger.jsonl"],
  "optionalIntegrations": [
    "Arcsweep world loader",
    "STARWELL host adapter",
    "DEEP observational adapter",
    "Notion canon authority resolver",
    "Supabase bridge event exporter"
  ],
  "permissions": ["local ledger read/write"],
  "consentRequirements": [
    "Packets cross only while consent_state is open",
    "Feather or Icarus pauses the bridge",
    "Notch performs explicit return"
  ],
  "networkRequirements": [],
  "deviceRequirements": [],
  "routes": ["GET /health", "GET /session"],
  "rooms": [],
  "commands": ["health", "demo", "serve"],
  "configurationSchema": null,
  "migrationVersion": "0.1.0",
  "lifecycle": {
    "install": "npm install",
    "launchStandalone": "npm run start",
    "enableInHost": null,
    "pause": "Feather | Icarus",
    "disableInHost": null,
    "removeFromHost": null,
    "uninstallStandalone": "remove package after exporting ./data",
    "restore": "restore ./data and restart"
  },
  "importProcedure": "Place a valid JSONL ledger in ./data/bridge-session-ledger.jsonl before launch.",
  "exportProcedure": "Copy ./data/bridge-session-ledger.jsonl; every line is a self-contained provenance receipt.",
  "healthChecks": [
    "Process starts without Hearthfire, Hearthgate, STARWELL, Notion, Supabase, or DEEP",
    "GET /health reports standalone state honestly",
    "Return anchor status is visible"
  ],
  "acceptanceTests": [
    "One full OPEN to CLOSED vertical slice",
    "Pause blocks packets",
    "Plain pass preserves controls",
    "Targetside external-evidence claims are rejected",
    "Notch returns cleanly",
    "Ledger replay preserves packet order"
  ],
  "provenance": [
    "Hearthfire issue #9",
    "2026-07-30 Rowan/Vee vertical-slice decision"
  ],
  "knownLimitations": [
    "v0.1 uses a manual world/canon resolver",
    "v0.1 exposes read-only HTTP health/session routes",
    "Host adapters are deliberately deferred until the standalone loop passes"
  ]
}

{
  "schemaVersion": "arkfire.module/v1",
  "moduleId": "arkfire.bridge-session",
  "canonicalName": "Hearthweave Bridge Session",
  "version": "0.2.0",
  "status": "IMPLEMENTED_LAMINATION_SLICE",
  "owner": "Rowan",
  "maintainers": ["Vee"],
  "description": "Standalone consent-aware runtime for one complete Hearthside to Targetside crossing, exchange, clean return, durable lamination, and replayable receipts.",
  "standalone": true,
  "standaloneEntrypoints": {
    "cli": "node cli.mjs",
    "service": "node cli.mjs serve",
    "demo": "node cli.mjs demo --world terra-aeterna",
    "laminationCli": "node lamination-cli.mjs",
    "laminationService": "node lamination-cli.mjs serve",
    "laminatedDemo": "node lamination-cli.mjs demo --world terra-aeterna"
  },
  "standaloneInterface": ["CLI", "HTTP health/status", "local JSONL receipt store"],
  "standaloneDataDirectory": "./data",
  "standaloneHealthCheck": "node cli.mjs health && node lamination-cli.mjs health",
  "standaloneTestCommand": "node --test test/*.test.mjs",
  "hostAdapters": [],
  "capabilities": [
    "bridge-session-lifecycle",
    "dual-presence-state",
    "typed-packet-exchange",
    "consent-pause",
    "explicit-return-anchor",
    "plain-presentation-pass",
    "jsonl-ledger-replay",
    "epistemic-register-enforcement",
    "clean-return-lamination",
    "four-layer-crossing-receipts",
    "lamination-latest-snapshot",
    "external-evidence-source-enforcement"
  ],
  "dataContracts": [
    "schema/bridge-session.schema.json",
    "schema/bridge-packet.schema.json",
    "schema/bridge-lamination.schema.json"
  ],
  "dataOwnership": [
    "bridge session ledger",
    "bridge session state",
    "bridge lamination ledger",
    "latest bridge lamination"
  ],
  "storageLocations": [
    "./data/bridge-session-ledger.jsonl",
    "./data/bridge-laminations.jsonl",
    "./data/bridge-lamination.latest.json"
  ],
  "optionalIntegrations": [
    "Arcsweep world loader",
    "STARWELL host adapter",
    "DEEP observational adapter",
    "Notion canon authority resolver",
    "Supabase bridge event exporter"
  ],
  "permissions": ["local ledger read/write"],
  "consentRequirements": [
    "Packets cross only while consent_state is open",
    "Feather or Icarus pauses the bridge",
    "Notch performs explicit return",
    "Lamination occurs only after CLOSED with an explicit clean-return receipt"
  ],
  "networkRequirements": [],
  "deviceRequirements": [],
  "routes": [
    "GET /health",
    "GET /session",
    "GET /lamination/latest",
    "GET /laminations"
  ],
  "rooms": [],
  "commands": [
    "health",
    "demo",
    "serve",
    "lamination health",
    "lamination demo",
    "lamination latest",
    "lamination replay",
    "lamination serve"
  ],
  "configurationSchema": null,
  "migrationVersion": "0.2.0",
  "lifecycle": {
    "install": "npm install",
    "launchStandalone": "npm run start",
    "enableInHost": null,
    "pause": "Feather | Icarus",
    "disableInHost": null,
    "removeFromHost": null,
    "uninstallStandalone": "remove package after exporting ./data",
    "restore": "restore ./data and restart"
  },
  "importProcedure": "Place valid JSONL ledgers in ./data before launch. Latest lamination may be regenerated from the final ledger line.",
  "exportProcedure": "Copy ./data/bridge-session-ledger.jsonl, ./data/bridge-laminations.jsonl, and ./data/bridge-lamination.latest.json.",
  "healthChecks": [
    "Bridge process starts without Hearthfire, Hearthgate, STARWELL, Notion, Supabase, or DEEP",
    "Lamination process starts without Hearthfire, Hearthgate, STARWELL, Notion, Supabase, or DEEP",
    "GET /health reports standalone state honestly",
    "Return anchor status is visible",
    "Lamination receipt count and paths are visible"
  ],
  "acceptanceTests": [
    "One full OPEN to CLOSED vertical slice",
    "Pause blocks packets",
    "Plain pass preserves controls",
    "Targetside external-evidence claims are rejected",
    "Notch returns cleanly",
    "Ledger replay preserves packet order",
    "A clean return produces one four-layer lamination receipt",
    "A non-closed bridge cannot be laminated",
    "A missing clean-return receipt blocks lamination",
    "Targetside narrative cannot be laminated as external observation",
    "Sourced Hearthside external observations preserve provenance"
  ],
  "provenance": [
    "Hearthfire issue #9",
    "2026-07-30 Rowan/Vee vertical-slice decision",
    "2026-07-30 Rowan/Vee Lamination Engine decision"
  ],
  "knownLimitations": [
    "v0.2 uses a manual world/canon resolver",
    "v0.2 exposes read-only HTTP health, session, and lamination routes",
    "Candidate laminate review is represented in data but does not yet have an interactive acceptance UI",
    "Host adapters are deliberately deferred until the standalone loop passes"
  ]
}

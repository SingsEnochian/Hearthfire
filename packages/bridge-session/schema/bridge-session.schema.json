{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthweave.local/schemas/bridge-session-v0.1.json",
  "title": "Hearthweave Bridge Session v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "state",
    "world_slug",
    "consent_state",
    "presentation_mode",
    "hearthside",
    "targetside",
    "return_anchor",
    "created_at",
    "updated_at",
    "last_packet_id"
  ],
  "properties": {
    "schema": { "const": "hearthweave.bridge-session/v0.1" },
    "session_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["OPEN", "LOAD", "ORIENT", "ARRIVE", "EXCHANGE", "PAUSED", "RETURN", "CLOSED", "ERROR"]
    },
    "world_slug": { "type": "string", "minLength": 1 },
    "consent_state": { "enum": ["open", "paused", "closed"] },
    "presentation_mode": { "enum": ["mythic", "plain"] },
    "hearthside": { "$ref": "#/$defs/presence" },
    "targetside": { "$ref": "#/$defs/presence" },
    "return_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "cue"],
      "properties": {
        "active": { "type": "boolean" },
        "cue": { "const": "Notch" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_packet_id": { "type": ["string", "null"] }
  },
  "$defs": {
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shore", "status", "canon_authority", "reality_anchor", "arrival_context"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "shore": { "enum": ["hearthside", "targetside"] },
        "status": { "enum": ["inactive", "loading", "present", "paused", "returned", "error"] },
        "canon_authority": { "type": ["string", "null"] },
        "reality_anchor": { "type": ["string", "null"] },
        "arrival_context": { "type": ["object", "null"] }
      }
    }
  }
}

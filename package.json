{
  "name": "@hearthfire/ark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "workspaces": [
    "packages/*",
    "starwell-server"
  ],
  "scripts": {
    "node:verify": "node scripts/verify-node-runtime.mjs",
    "check": "npm run node:verify && tsc --noEmit",
    "test": "npm run node:verify && node --test",
    "starwell:start": "npm run start --workspace=@hearthfire/starwell-server",
    "starwell:dev": "npm run dev --workspace=@hearthfire/starwell-server",
    "starwell:check": "npm run check --workspace=@hearthfire/starwell-server",
    "starwell:test": "npm run test --workspace=@hearthfire/starwell-server"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
